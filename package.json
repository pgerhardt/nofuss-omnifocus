{
  "name": "nofuss-omnifocus",
  "version": "0.1.0-beta.4",
  "description": "NoFuss for OmniFocus — bounded CLI and MCP reads with explicitly authorized safe writes",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "nofuss-omnifocus-mcp": "dist/index.js",
    "nofuss-omnifocus": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "docs/cli.md",
    "docs/contract.md",
    "docs/local-release.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "RELEASE_NOTES.md",
    "docs/safe-writes.md",
    "docs/inbox-parent-capture.md",
    "docs/calendar-recurrence.md",
    "docs/task-hierarchy.md",
    "docs/taxonomy-lifecycle.md",
    "docs/perspectives.md",
    "docs/task-batch.md",
    "docs/native-capabilities.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check src scripts test docs README.md package.json tsconfig.json",
    "format": "prettier --write src scripts test docs README.md package.json tsconfig.json",
    "test": "node --test --test-concurrency=2 test/*.test.mjs",
    "start": "node dist/index.js",
    "call": "node scripts/call.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "js-tiktoken": "1.0.21",
    "prettier": "3.8.3",
    "typescript": "5.9.3"
  }
}
